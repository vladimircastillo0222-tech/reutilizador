# ===== Reutilizador de Contenido — configuración =====
# Copia este archivo a ".env" y rellena tus valores.
# NUNCA subas el archivo .env a git (ya está en .gitignore).

# Puerto local
PORT=3000
# URL base (para los retornos de Stripe). En producción: https://tudominio.com
BASE_URL=http://localhost:3000

# Secreto para firmar las sesiones (JWT). Genera uno largo y aleatorio.
# Ejemplo para generarlo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Dónde se guarda la base de datos SQLite (se crea sola al arrancar)
DB_PATH=./data/app.db

# Usos gratis por mes (plan Free)
FREE_MONTHLY_LIMIT=5

# ===== Proveedor de IA =====
# "local"     = motor de plantillas incluido en el proyecto (GRATIS, sin API). Valor por defecto.
# "openai"    = API de OpenAI (requiere OPENAI_API_KEY y CUESTA DINERO por cada uso).
# "anthropic" = API de Anthropic (requiere ANTHROPIC_API_KEY y CUESTA DINERO por cada uso).
AI_PROVIDER=local
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ===== Stripe — SOLO MODO DE PRUEBA =====
# Usa ÚNICAMENTE claves de prueba (empiezan con sk_test_ / pk_test_).
# El servidor SE NIEGA a arrancar si detecta claves reales (sk_live_).
# Consigue tus claves de prueba gratis en https://dashboard.stripe.com/test/apikeys
# (sin tarjeta, sin verificación de negocio).
# STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA_DE_PRUEBA
# STRIPE_PUBLISHABLE_KEY=pk_test_TU_CLAVE_PUBLICA_DE_PRUEBA
# STRIPE_PRICE_ID=price_ID_DE_TU_PRECIO_DE_PRUEBA_19_USD_MES
# STRIPE_WEBHOOK_SECRET=whsec_TU_SECRETO_DE_PRUEBA
